{
  "name": "vue-story",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "vite preview --outDir storybook-static --port 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@shilp.dev/list-types": "workspace:*",
    "@shilp.dev/vue-list": "workspace:*",
    "vue": "^3.5.40",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/vue3": "^10.5.7",
    "@storybook/test": "8.6.15",
    "@storybook/vue3-vite": "^10.5.7",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "@vue/tsconfig": "^0.9.1",
    "playwright": "latest",
    "storybook": "^10.5.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest",
    "vue-tsc": "^3.3.8"
  }
}
