{
  "name": "react-list",
  "version": "1.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run --parallel dev",
    "dev:react": "pnpm --filter \"./apps/react/*\" run --parallel dev",
    "dev:vue": "pnpm --filter \"./apps/vue/*\" run --parallel dev",
    "dev:react:playground": "pnpm --filter react-playground-typescript run dev",
    "dev:vue:playground": "pnpm --filter vue-playground-typescript run dev",
    "dev:react:docs": "pnpm --filter react-docs run dev",
    "dev:vue:docs": "pnpm --filter vue-docs run dev",
    "build": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run build",
    "build:react": "pnpm --filter \"./apps/react/*\" run build",
    "build:vue": "pnpm --filter \"./apps/vue/*\" run build",
    "build:react:playground": "pnpm --filter react-playground-typescript run build",
    "build:vue:playground": "pnpm --filter vue-playground-typescript run build",
    "build:react:docs": "pnpm --filter react-docs run build",
    "build:vue:docs": "pnpm --filter vue-docs run build",
    "start": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run preview",
    "start:react:playground": "pnpm --filter react-playground-typescript run preview",
    "start:vue:playground": "pnpm --filter vue-playground-typescript run preview",
    "start:react:docs": "pnpm --filter react-docs run preview",
    "start:vue:docs": "pnpm --filter vue-docs run preview",
    "build:types": "pnpm --filter @7span/list-types build",
    "build:react-list": "pnpm build:types && pnpm --filter @7span/react-list build",
    "build:vue-list": "pnpm build:types && pnpm --filter @7span/vue-list build",
    "build:packages": "pnpm build:types && pnpm --filter @7span/react-list build && pnpm --filter @7span/vue-list build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
