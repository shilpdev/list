{
  "name": "react-list",
  "version": "0.0.1",
  "description": "",
  "packageManager": "pnpm@11.9.0",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run --parallel dev",
    "dev:react": "pnpm --filter \"./apps/react/*\" run --parallel dev",
    "dev:vue": "pnpm --filter \"./apps/vue/*\" run --parallel dev",
    "dev:react:playground": "pnpm --filter react-playground run dev",
    "dev:vue:playground": "pnpm --filter vue-playground run dev",
    "dev:react:docs": "pnpm --filter react-docs run dev",
    "dev:vue:docs": "pnpm --filter vue-docs run dev",
    "dev:story": "pnpm --filter react-story --filter vue-story run --parallel storybook",
    "dev:react:story": "pnpm --filter react-story run storybook",
    "dev:vue:story": "pnpm --filter vue-story run storybook",
    "build": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run build",
    "build:react": "pnpm --filter \"./apps/react/*\" run build",
    "build:vue": "pnpm --filter \"./apps/vue/*\" run build",
    "build:react:playground": "pnpm --filter react-playground run build",
    "build:vue:playground": "pnpm --filter vue-playground run build",
    "build:react:docs": "pnpm --filter react-docs run build",
    "build:vue:docs": "pnpm --filter vue-docs run build",
    "build:story": "pnpm --filter react-story --filter vue-story run build-storybook",
    "build:react:story": "pnpm --filter react-story run build-storybook",
    "build:vue:story": "pnpm --filter vue-story run build-storybook",
    "start": "pnpm --filter \"./apps/react/*\" --filter \"./apps/vue/*\" run preview",
    "start:react:playground": "pnpm --filter react-playground run preview",
    "start:vue:playground": "pnpm --filter vue-playground run preview",
    "start:react:docs": "pnpm --filter react-docs run preview",
    "start:vue:docs": "pnpm --filter vue-docs run preview",
    "start:story": "pnpm --filter react-story --filter vue-story run --parallel preview-storybook",
    "start:react:story": "pnpm --filter react-story run preview-storybook",
    "start:vue:story": "pnpm --filter vue-story run preview-storybook",
    "build:types": "pnpm --filter @shilp.dev/list-types build",
    "build:react-list": "pnpm build:types && pnpm --filter @shilp.dev/react-list build",
    "build:vue-list": "pnpm build:types && pnpm --filter @shilp.dev/vue-list build",
    "build:packages": "pnpm build:types && pnpm --filter @shilp.dev/react-list build && pnpm --filter @shilp.dev/vue-list build",
    "test:setup": "pnpm --filter react-story exec playwright install chromium",
    "test:story": "pnpm test:setup && pnpm --filter react-story --filter vue-story run --parallel test",
    "test:react:story": "pnpm test:setup && pnpm --filter react-story run test",
    "test:vue:story": "pnpm test:setup && pnpm --filter vue-story run test"
  },
  "overrides": {
    "aria-query": "5.3.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
