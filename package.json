{
  "name": "react-list",
  "version": "1.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter {apps/*} run dev",
    "dev:docs": "pnpm --filter docs run dev",
    "dev:playground": "pnpm --filter playground run dev",
    "dev:playground-typescript": "pnpm --filter playground-typescript run dev",
    "dev:playground-vue3": "pnpm --filter vue-list-vue3-playground run dev",
    "build": "pnpm --filter {apps/*} run build",
    "build:docs": "pnpm --filter docs run build",
    "build:playground": "pnpm --filter playground run build",
    "build:playground-typescript": "pnpm --filter playground-typescript run build",
    "start": "pnpm --filter {apps/*} run preview",
    "start:docs": "pnpm --filter docs run preview",
    "build:types": "pnpm --filter @7span/list-types build",
    "build:react-list": "pnpm build:types && pnpm --filter @7span/react-list build",
    "build:vue-list": "pnpm build:types && pnpm --filter @7span/vue-list build",
    "build:packages": "pnpm build:types && pnpm --filter @7span/react-list build && pnpm --filter @7span/vue-list build"
