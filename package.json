{
  "name": "shilp",
  "version": "0.0.1",
  "description": "",
  "packageManager": "pnpm@11.9.0",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" run --parallel dev",
    "dev:react": "pnpm --filter ./apps/react-demo run dev",
    "dev:vue": "pnpm --filter ./apps/vue-demo run dev",
    "dev:next": "pnpm --filter ./apps/next-demo run dev",
    "dev:nuxt": "pnpm --filter ./apps/nuxt-demo run dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:apps": "pnpm --filter \"./apps/*\" run build",
    "build:react": "pnpm --filter ./apps/react-demo run build",
    "build:vue": "pnpm --filter ./apps/vue-demo run build",
    "build:next": "pnpm --filter ./apps/next-demo run build",
    "build:nuxt": "pnpm --filter ./apps/nuxt-demo run build",
    "start:react": "pnpm --filter ./apps/react-demo run preview",
    "start:vue": "pnpm --filter ./apps/vue-demo run preview",
    "start:next": "pnpm --filter ./apps/next-demo run start",
    "start:nuxt": "pnpm --filter ./apps/nuxt-demo run preview",
    "build:react-list": "pnpm --filter @shilp.dev/react-list build",
    "build:vue-list": "pnpm --filter @shilp.dev/vue-list build",
    "build:packages": "pnpm build:react-list && pnpm build:vue-list",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "lint": "pnpm --filter \"./packages/*\" run lint",
    "format": "pnpm --filter \"./packages/*\" run format"
  },
  "overrides": {
    "aria-query": "5.3.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "fast-deep-equal": "^3.1.3"
  }
}
