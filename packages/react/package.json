{
  "name": "@shilp.dev/react-list",
  "version": "1.1.0",
  "description": "A simple and reusable list component for React",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @shilp.dev/list-types build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "main": "dist/react-list.js",
  "module": "dist/react-list.js",
  "types": "dist/react-list.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react-list.d.ts",
        "default": "./dist/react-list.js"
      },
      "require": {
        "types": "./dist/react-list.d.ts",
        "default": "./dist/react-list.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@shilp.dev/list-types": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@shilp.dev/list-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shilp.dev/list-types": "workspace:*",
    "@types/react": "^19.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^4.5.0"
  }
}