{
  "name": "@7span/vue-list",
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @7span/list-types build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build"
  },
  "main": "dist/vue-list.js",
  "types": "dist/vue-list.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/vue-list.d.ts",
        "default": "./dist/vue-list.js"
      },
      "require": {
        "types": "./dist/vue-list.d.ts",
        "default": "./dist/vue-list.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "@7span/list-types": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@7span/list-types": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@7span/list-types": "workspace:*",
    "@eslint/js": "^9.22.0",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
